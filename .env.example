# Required for embeddings (ingest) and the agent + judge models.
OPENAI_API_KEY=sk-...

# Optional. Without it, `park-ingest` falls back to data/parks_snapshot.json.
# Free key: https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# Defaults below match compose.yaml; override only if you moved something.
PG_DSN=postgresql://postgres:postgres@localhost:5433/parks
CHROMA_DIR=
CHROMA_COLLECTION=parks
EMBED_MODEL=text-embedding-3-small
# shifting to gpt-6-luna as open ai is migrating off gpt-4o/4.1 (circa 10-2026)
AGENT_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6-luna

# LangSmith tracing (optional). The API key is read from your shell or put it here.
# Portal: https://smith.langchain.com/o/5eb087f6-34d7-4bf9-8857-af42ef22e08c
LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=park-concierge
# EU region: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only needed if your key is org-scoped (see docs/langsmith.md)
# LANGSMITH_WORKSPACE_ID=
